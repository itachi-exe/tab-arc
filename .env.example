# Network: arc (mainnet) or arcTestnet
ARC_NETWORK=arc
VITE_ARC_NETWORK=arc
# Your deployed Tab contract
VITE_TAB_ADDRESS=
# Agent key that relays texts within each user's daily limit. Hot wallet, keep it small.
AGENT_PRIVATE_KEY=
# Shared secret between the iMessage bridge and the API, and for signed links
IMESSAGE_RELAY_SECRET=
TAB_LINK_SECRET=
# Public URL used in reply links
APP_URL=http://localhost:5173
# Intent parser (DeepSeek compatible)
DEEPSEEK_API_KEY=
# iMessage line (Photon)
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
TAB_LINE=
# Optional: where the off chain user map lives (default server/db.json)
TAB_DB_PATH=
